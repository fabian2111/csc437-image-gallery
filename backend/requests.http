### Get all images.  Each request **MUST** be delimited by a triple hash
# This is a comment
GET http://localhost:3000/api/images

### A second example.  Each request **MUST** be delimited by a triple hash
POST http://localhost:3000/api/test
Content-Type: application/json # Content-Type header is a must if you're sending JSON
# Request body separated from headers by newline

### 204 Worked
PUT http://localhost:3000/api/images/69aa58691b3aa526bf385406
Content-Type: application/json

{
    "name": "new-name"
}

###
# 404 not found
PUT http://localhost:3000/api/images/69aa58691
Content-Type: application/json

{
    "name": "samplename"
}

###
# 413 name too big
PUT http://localhost:3000/api/images/69aa58691b3aa526bf385406
Content-Type: application/json

{
    "name": "overonehundredcharactersoveronehundredcharactersoveronehundredcharactersoveronehundredcharactersoveronehundredcharacters"
}

###
# 400 wrong format
PUT http://localhost:3000/api/images/69aa58691b3aa526bf385406
Content-Type: application/json

{
    "email": "test"
}
